<xbox:XboxApplicationPage x:Class="CatalogBrowser.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:sdk="clr-namespace:XboxSdk.Samples"
    Title="Details">
  <Grid Background="#FF14202C">
    <Grid Margin="64,36,64,36">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="Poster" Width="320" Height="480" Stretch="UniformToFill" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Margin="40,0,0,0" sdk:DirectionalFocus.IsEnabled="True">
        <TextBlock x:Name="Category" FontSize="22" Foreground="{StaticResource Muted}" />
        <TextBlock x:Name="TitleText" FontSize="48" Foreground="White" TextWrapping="Wrap" />
        <TextBlock x:Name="Facts" FontSize="24" Foreground="#FFBBBBBB" Margin="0,4,0,16" />
        <TextBlock x:Name="Description" FontSize="26" Foreground="#FFDDDDDD" TextWrapping="Wrap" Margin="0,0,0,24" />
        <Button x:Name="FavoriteButton" Style="{StaticResource ActionButton}" Click="Favorite_Click" xbox:Legend.AButtonText="select" />
        <Button Content="Back to the catalog" Style="{StaticResource ActionButton}" Click="Back_Click" xbox:Legend.AButtonText="select" />
        <TextBlock x:Name="Status" FontSize="20" Foreground="{StaticResource Muted}" Margin="0,16,0,0" />
      </StackPanel>
      <xbox:Legend Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
