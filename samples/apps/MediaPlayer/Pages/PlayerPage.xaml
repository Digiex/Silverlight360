<xbox:XboxApplicationPage x:Class="MediaPlayer.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    Title="Player">
  <Grid Background="Black">
    <!-- MediaTransport is the Xbox playback chrome: transport bar, timeline,
         status and busy indicator. The MediaElement inside it is the player
         it drives; it's picked up as MediaTransport.MediaElement. -->
    <xbox:MediaTransport x:Name="Transport" Back="Transport_Back">
      <MediaElement x:Name="Player" AutoPlay="True" />
    </xbox:MediaTransport>
    <TextBlock x:Name="Status" FontSize="22" Foreground="#FF9FC5E8" Margin="64,36" VerticalAlignment="Top" />
  </Grid>
</xbox:XboxApplicationPage>
