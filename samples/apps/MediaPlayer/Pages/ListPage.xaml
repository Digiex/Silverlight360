<xbox:XboxApplicationPage x:Class="MediaPlayer.Pages.ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:sdk="clr-namespace:XboxSdk.Samples"
    Title="Media">
  <Grid Background="#FF101820">
    <StackPanel Margin="64,36,64,36">
      <TextBlock Text="Media player" FontSize="44" Foreground="White" />
      <TextBlock x:Name="Status" FontSize="22" Foreground="#FF9FC5E8" Margin="0,0,0,24" TextWrapping="Wrap" />
      <StackPanel x:Name="Files" sdk:DirectionalFocus.IsEnabled="True" />
    </StackPanel>
  </Grid>
</xbox:XboxApplicationPage>
