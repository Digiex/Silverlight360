<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="MediaPlayer.App"
             Startup="Application_Startup"
             UnhandledException="Application_UnhandledException">
  <Application.Resources>
    <!-- Where the test server runs (samples\TestServer\server.py). It serves
         the files you put in samples\TestServer\media. -->
    <sys:String x:Key="ServerUrl">http://127.0.0.1:8360/</sys:String>

    <Style x:Key="FileButton" TargetType="Button">
      <Setter Property="Width" Value="760" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="FocusStates">
                  <VisualState x:Name="Focused">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Unfocused" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Rectangle Fill="#FF2A3440" />
              <Rectangle x:Name="FocusFill" Fill="#FF51860F" Opacity="0" />
              <ContentPresenter Margin="20,0" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
