<UserControl x:Class="GamepadInput.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
  <UserControl.Resources>
    <!-- One button indicator: a circle that lights up while held. -->
    <Style x:Key="Indicator" TargetType="Border">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="Background" Value="#FF2A3440" />
      <Setter Property="BorderBrush" Value="#FF5A6A7A" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="IndicatorText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <!-- The page takes focus so controller events reach it; they bubble up
       from whatever element has focus. -->
  <Grid x:Name="LayoutRoot" Background="#FF101820">
    <!-- Keep content inside the title-safe area: 90% of 1280x720. -->
    <Grid Margin="64,36,64,36">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="170" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Gamepad input" FontSize="44" Foreground="White" />
        <TextBlock Text="Press buttons, move the sticks and pull the triggers. Back + Start together exits."
                   FontSize="22" Foreground="#FF9FC5E8" />
      </StackPanel>

      <Canvas Grid.Row="1" Width="1000" Height="340" Margin="0,16,0,0">
        <!-- Shoulders and triggers -->
        <Border x:Name="LeftShoulder" Style="{StaticResource Indicator}" Width="140" CornerRadius="12" Canvas.Left="60" Canvas.Top="0">
          <TextBlock Text="LB" Style="{StaticResource IndicatorText}" />
        </Border>
        <Border x:Name="RightShoulder" Style="{StaticResource Indicator}" Width="140" CornerRadius="12" Canvas.Left="800" Canvas.Top="0">
          <TextBlock Text="RB" Style="{StaticResource IndicatorText}" />
        </Border>
        <Border Width="30" Height="120" Canvas.Left="10" Canvas.Top="0" Background="#FF2A3440">
          <Rectangle x:Name="LeftTrigger" Fill="#FF77BA02" Height="0" VerticalAlignment="Bottom" />
        </Border>
        <Border Width="30" Height="120" Canvas.Left="960" Canvas.Top="0" Background="#FF2A3440">
          <Rectangle x:Name="RightTrigger" Fill="#FF77BA02" Height="0" VerticalAlignment="Bottom" />
        </Border>

        <!-- Left stick -->
        <Border Width="140" Height="140" CornerRadius="70" Canvas.Left="60" Canvas.Top="90" Background="#FF1C242E" BorderBrush="#FF5A6A7A" BorderThickness="2">
          <Canvas Width="140" Height="140">
            <Ellipse x:Name="LeftStickDot" Width="36" Height="36" Fill="#FF77BA02" Canvas.Left="52" Canvas.Top="52" />
          </Canvas>
        </Border>
        <Border x:Name="LeftStick" Style="{StaticResource Indicator}" Width="40" Height="40" CornerRadius="20" Canvas.Left="110" Canvas.Top="240">
          <TextBlock Text="L" FontSize="16" Style="{StaticResource IndicatorText}" />
        </Border>

        <!-- D-pad -->
        <Border x:Name="DPadUp" Style="{StaticResource Indicator}" CornerRadius="8" Canvas.Left="280" Canvas.Top="120"><Polygon Points="10,0 20,16 0,16" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <Border x:Name="DPadLeft" Style="{StaticResource Indicator}" CornerRadius="8" Canvas.Left="212" Canvas.Top="188"><Polygon Points="0,10 16,0 16,20" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <Border x:Name="DPadRight" Style="{StaticResource Indicator}" CornerRadius="8" Canvas.Left="348" Canvas.Top="188"><Polygon Points="16,10 0,0 0,20" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <Border x:Name="DPadDown" Style="{StaticResource Indicator}" CornerRadius="8" Canvas.Left="280" Canvas.Top="256"><Polygon Points="0,0 20,0 10,16" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>

        <!-- Back, Start -->
        <Border x:Name="Back" Style="{StaticResource Indicator}" Width="80" Height="44" CornerRadius="22" Canvas.Left="400" Canvas.Top="110">
          <TextBlock Text="Back" FontSize="16" Style="{StaticResource IndicatorText}" />
        </Border>
        <Border x:Name="Start" Style="{StaticResource Indicator}" Width="80" Height="44" CornerRadius="22" Canvas.Left="520" Canvas.Top="110">
          <TextBlock Text="Start" FontSize="16" Style="{StaticResource IndicatorText}" />
        </Border>

        <!-- Right stick -->
        <Border Width="140" Height="140" CornerRadius="70" Canvas.Left="590" Canvas.Top="150" Background="#FF1C242E" BorderBrush="#FF5A6A7A" BorderThickness="2">
          <Canvas Width="140" Height="140">
            <Ellipse x:Name="RightStickDot" Width="36" Height="36" Fill="#FF77BA02" Canvas.Left="52" Canvas.Top="52" />
          </Canvas>
        </Border>
        <Border x:Name="RightStick" Style="{StaticResource Indicator}" Width="40" Height="40" CornerRadius="20" Canvas.Left="640" Canvas.Top="296">
          <TextBlock Text="R" FontSize="16" Style="{StaticResource IndicatorText}" />
        </Border>

        <!-- Face buttons -->
        <Border x:Name="Y" Style="{StaticResource Indicator}" Canvas.Left="840" Canvas.Top="90"><TextBlock Text="Y" Foreground="#FFFFC20E" Style="{StaticResource IndicatorText}" /></Border>
        <Border x:Name="X" Style="{StaticResource Indicator}" Canvas.Left="770" Canvas.Top="160"><TextBlock Text="X" Foreground="#FF2B8CDD" Style="{StaticResource IndicatorText}" /></Border>
        <Border x:Name="B" Style="{StaticResource Indicator}" Canvas.Left="910" Canvas.Top="160"><TextBlock Text="B" Foreground="#FFE0442E" Style="{StaticResource IndicatorText}" /></Border>
        <Border x:Name="A" Style="{StaticResource Indicator}" Canvas.Left="840" Canvas.Top="230"><TextBlock Text="A" Foreground="#FF77BA02" Style="{StaticResource IndicatorText}" /></Border>
      </Canvas>

      <Border Grid.Row="2" Background="#FF1C242E" Padding="16,8">
        <TextBlock x:Name="EventLog" FontSize="20" Foreground="#FFDDDDDD" FontFamily="Courier New" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
