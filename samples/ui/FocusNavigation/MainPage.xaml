<UserControl x:Class="FocusNavigation.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:XboxSdk.Samples"
             Width="1280" Height="720">
  <Grid Background="#FF101820">
    <Grid Margin="64,36,64,36">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Focus navigation" FontSize="44" Foreground="White" />
        <TextBlock Text="Move between tiles with the D-pad or left stick, press A to pick one."
                   FontSize="22" Foreground="#FF9FC5E8" />
      </StackPanel>

      <!-- Plain Buttons in a Grid. The runtime clicks the focused Button when
           A is pressed, but doesn't move focus: DirectionalFocus (samples\Common)
           moves it to the nearest control in the direction pressed. -->
      <Grid x:Name="Tiles" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
            sdk:DirectionalFocus.IsEnabled="True">
        <Grid.RowDefinitions>
          <RowDefinition /><RowDefinition /><RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource TileButton}" Content="Home" x:Name="FirstTile" />
        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileButton}" Content="Movies" />
        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource TileButton}" Content="TV" />
        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource TileButton}" Content="Music" />
        <!-- A wide tile spanning two columns. -->
        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Width="500" Style="{StaticResource TileButton}" Content="Featured" />
        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource TileButton}" Content="Search" />
        <!-- Disabled controls are skipped. -->
        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource TileButton}" Content="(disabled)" IsEnabled="False" />
        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource TileButton}" Content="Settings" />
        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource TileButton}" Content="Help" />
        <!-- IsTabStop="False" leaves a control out of navigation. -->
        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource TileButton}" Content="(not a tab stop)" IsTabStop="False" />
        <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource TileButton}" Content="About" />
      </Grid>

      <TextBlock x:Name="Status" Grid.Row="2" FontSize="24" Foreground="#FFDDDDDD" />
    </Grid>
  </Grid>
</UserControl>
