<UserControl x:Class="HelloXbox.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
  <Grid x:Name="LayoutRoot">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0E2A12" Offset="0" />
        <GradientStop Color="#FF1F6E2A" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="96,64,96,0">
      <TextBlock Text="Hello, Xbox 360" FontSize="56" Foreground="White" />
      <TextBlock Text="Built with Silverlight360" FontSize="24" Foreground="#FFB8E6B0" />
    </StackPanel>

    <Border Grid.Row="1" Margin="96,32,96,0" Padding="24" CornerRadius="8" Background="#66000000">
      <StackPanel>
        <TextBlock x:Name="ServerText" FontSize="22" Foreground="#FFB8E6B0" />
        <TextBlock x:Name="GreetingText" Text="Contacting the server..." FontSize="32" Foreground="White" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="TimeText" FontSize="26" Foreground="White" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="96,24,96,0" Padding="24" CornerRadius="8" Background="#44000000">
      <StackPanel>
        <TextBlock Text="Request log" FontSize="22" Foreground="#FFB8E6B0" />
        <TextBlock x:Name="LogText" FontSize="20" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="96,24,96,56">
      <Button x:Name="EchoButton" Content="Send echo (A)" FontSize="26" Padding="24,10" Click="EchoButton_Click" />
      <TextBlock x:Name="EchoText" FontSize="26" Foreground="White" VerticalAlignment="Center" Margin="24,0,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
