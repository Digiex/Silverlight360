<UserControl x:Class="PlatformCalls.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
  <Grid x:Name="LayoutRoot" Background="#FF101820">
    <StackPanel Margin="96,64,96,48">
      <TextBlock Text="Platform call test" FontSize="48" Foreground="White" />
      <TextBlock Text="The paths apps take to save settings, use the cache drive and drive the playback bar"
                 FontSize="22" Foreground="#FF9FC5E8" />
      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
        <Button x:Name="SaveButton" Content="Encrypted save" FontSize="24" Padding="16,8" Margin="0,0,16,0" Click="SaveButton_Click" />
        <Button x:Name="CacheButton" Content="Cache drive" FontSize="24" Padding="16,8" Margin="0,0,16,0" Click="CacheButton_Click" />
        <Button x:Name="PlaybackButton" Content="Playback bar" FontSize="24" Padding="16,8" Click="PlaybackButton_Click" />
      </StackPanel>
      <TextBlock x:Name="ResultsText" FontSize="22" Foreground="White" Margin="0,24,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <MediaElement x:Name="Player" AutoPlay="False" Width="1" Height="1" />
  </Grid>
</UserControl>
